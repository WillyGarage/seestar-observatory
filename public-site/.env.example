# Copy to .env next to app.py. The container reads this file; it is never committed
# and never ends up in the image.

# The one bearer token for every /api/* route. Generate with:  openssl rand -hex 32
SITE_TOKEN=change-me

# Password for /admin. Not linked from anywhere; the only way in.
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. Set it so logins survive a restart.
SECRET_KEY=change-me

PORT=8090
DATA_DIR=./data

# Branding and local time.
SITE_TITLE=Sky
SITE_SUBTITLE=Pictures from a Seestar S50 Pro.
OWNER_NAME=Owner
TIMEZONE=UTC
