# Copy to ~/.config/seestar/seestar.env and fill in. Read by skills/seestar/config.py.
# Anything here can also be set as a normal environment variable, which wins.

# The telescope's address on your LAN. Give it a DHCP reservation on the router.
SEESTAR_IP=192.168.1.50

# Where you observe from, decimal degrees, north/east positive. Match what you set
# in the Seestar phone app. Two decimal places is plenty and keeps your address out
# of the file.
SEESTAR_LAT=51.48
SEESTAR_LON=-0.13
SEESTAR_ELEV_M=10
SEESTAR_TZ=Europe/London

# Where images land. Tens of GB over a few months.
SEESTAR_OUT=~/seestar/captures

# Optional: nearest airport weather station, for the cloud check before opening the
# arm. US only (api.weather.gov). Leave blank elsewhere.
SEESTAR_METAR_STATION=
SEESTAR_WEATHER_CONTACT=you@example.com

# Optional: a box you can ssh to that serves a directory over HTTP, so you can look
# at a fresh image on your phone. Leave SEESTAR_PUBLISH_HOST blank to disable.
SEESTAR_PUBLISH_HOST=
SEESTAR_PUBLISH_DIR=~/images
SEESTAR_PUBLISH_URL=

# Optional: the public gallery site, if you run one. Used by `seestar gallery publish`
# and `seestar requests`. This file is also read as ~/.config/seestar/public-site.env.
PUBLIC_SITE_URL=
PUBLIC_SITE_TOKEN=
