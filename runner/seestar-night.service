[Unit]
Description=Seestar night runner (drives the telescope through runner/plan.json)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/seestar-observatory
ExecStart=%h/seestar-observatory/skills/seestar/.venv/bin/python %h/seestar-observatory/runner/night.py run
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1
# Adjust the two paths above if you cloned the repo somewhere other than ~/seestar-observatory.

[Install]
WantedBy=default.target
